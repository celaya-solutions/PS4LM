+
 /**
  * Returns number of CPUs on system that are useful for math.
  */
 int32_t common_cpu_get_num_math() {
-#if defined(__x86_64__) && defined(__linux__) && !defined(__ANDROID__)
+#if defined(PS4LM)
+    // A PS4 payload may run on only a few of the console's CPUs (its affinity
+    // mask), and using all of them can shut the console down. Default to the
+    // allowed CPUs minus 2, at least 1; -t still overrides (patches/0001).
+    cpuset_t mask;
+    CPU_ZERO(&mask);
+    int allowed = 0;
+    if (cpuset_getaffinity(CPU_LEVEL_WHICH, CPU_WHICH_PID, -1, sizeof(mask), &mask) == 0) {
+        for (int i = 0; i < CPU_SETSIZE; i++) {
+            allowed += CPU_ISSET(i, &mask) ? 1 : 0;
+        }
+    }
+    return std::max(1, allowed - 2);
+#elif defined(__x86_64__) && defined(__linux__) && !defined(__ANDROID__)
     int n_cpu = sysconf(_SC_NPROCESSORS_ONLN);
     if (n_cpu < 1) {
         return common_cpu_get_num_physical_cores();
